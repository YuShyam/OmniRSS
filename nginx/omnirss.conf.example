# ==============================================================================
# OmniRSS Nginx 反向代理最佳實踐設定範本 (nginx/omnirss.conf.example)
# 適用場景: 伺服器 Nginx 反向代理網關，將專屬網域安全轉發至 Docker OmniRSS 容器 (Port 8082)
# ==============================================================================

# 1. 流量速率限制區 (每秒單一 IP 最大 30 次請求，適配高頻 RSS Reader 與併發圖片抓取)
limit_req_zone $binary_remote_addr zone=omnirss_limit:10m rate=30r/s;

# HTTP 80 自動轉向 HTTPS 與 Certbot 驗證通道
server {
    listen 80;
    server_name rss.yourdomain.com;  # 請替換為您的實際網域名稱

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 443 反向代理
server {
    listen 443 ssl http2;
    server_name rss.yourdomain.com;  # 請替換為您的實際網域名稱

    # Let's Encrypt SSL 憑證路徑 (請依實際 Certbot 申請路徑調整)
    ssl_certificate /etc/letsencrypt/live/rss.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rss.yourdomain.com/privkey.pem;

    # SSL 安全加固協定
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # OWASP 資安防護標頭 (Security Headers)
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Payload 封包容量限制 (例如備份檔匯入與圖片下載)
    client_max_body_size 10M;

    # 靜態去重圖片與前端資源放行區 (免除嚴格限流，防止多圖文章卡頓)
    location ~* ^/(api/assets/|static/|favicon) {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 強快取標頭 (1 年不可變)
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 標準 API 與 Web UI 反向代理通道 (8082)
    location / {
        limit_req zone=omnirss_limit burst=60 nodelay;

        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 與 Server-Sent Events (SSE) 即時通訊支援
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
