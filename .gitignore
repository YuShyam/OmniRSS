# OmniRSS Git Ignore Rules

# Runtime Data & Storage (資料庫與去重圖庫)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# Logs & Telemetry
logs/
*.log

# Scratch & Temporary Files
scratch/
scratch_*
*.bak
*.tmp

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

